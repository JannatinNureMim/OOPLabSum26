import java.util.*;

class Student {
    int[] scores = new int[5];

    void input() {
        Scanner sc = new Scanner(System.in);
        for (int i = 0; i < 5; i++) {
            scores[i] = sc.nextInt();
        }
    }

    int calculateTotalScore() {
        int sum = 0;
        for (int i = 0; i < 5; i++) {
            sum += scores[i];
        }
        return sum;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        Student kristen = new Student();
        kristen.input();
        int kristenScore = kristen.calculateTotalScore();

        int count = 0;

        for (int i = 1; i < n; i++) {
            Student student = new Student();
            student.input();

            if (student.calculateTotalScore() > kristenScore) {
                count++;
            }
        }

        System.out.println(count);
    }
}
